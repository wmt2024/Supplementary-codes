TITLE: Manual BCH regression for SA - 3-class LPA;

DATA: 
  FILE = LPA_BCH_weights.dat;

VARIABLE:
  NAMES ARE ZFEELING ZEXPECTA ZBROODIN ZREFLECT SA BCHW1 BCHW2 BCHW3;
  USEVAR = SA BCHW1 BCHW2 BCHW3;
  CATEGORICAL = SA;
  CLASSES = c(3);
  TRAINING = BCHW1 BCHW2 BCHW3 (BCH);

ANALYSIS:
  TYPE = MIXTURE;
  STARTS = 0;     
  ESTIMATOR = MLR;

MODEL:
%C#1%
  [SA$1];

%C#2%
  [SA$1];  

%C#3%
  [SA$1];   

OUTPUT:
  TECH1 TECH8; 
  CINTERVAL;   
  SVALUES;     
