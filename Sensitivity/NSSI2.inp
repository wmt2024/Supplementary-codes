TITLE: Manual BCH regression for NSSI - 4-class LPA;

DATA: 
  FILE = LPA_BCH_weights_NSSI_4class.dat;

VARIABLE:
  NAMES ARE ZFEELING ZEXPECTA ZBROODIN ZREFLECT NSSI BCHW1 BCHW2 BCHW3 BCHW4;
  USEVAR = NSSI BCHW1 BCHW2 BCHW3 BCHW4;
  CATEGORICAL = NSSI;
  CLASSES = c(4);
  TRAINING = BCHW1 BCHW2 BCHW3 BCHW4 (BCH);

ANALYSIS:
  TYPE = MIXTURE;
  STARTS = 0;     
  ESTIMATOR = MLR;

MODEL:
%C#1%
  [NSSI$1];  

%C#2%
  [NSSI$1];  

%C#3%
  [NSSI$1];  

%C#4%
  [NSSI$1];  

OUTPUT:
  TECH1 TECH8;  
  CINTERVAL;   
  SVALUES;     