TITLE: Manual BCH regression for SA - 4-class LPA;

DATA: 
  FILE = LPA_BCH_weights.dat;

VARIABLE:
  NAMES ARE Zfeeling Zexpectation Zbrooding Zreflection SA BCHW1 BCHW2 BCHW3 BCHW4;
  USEVAR = SA BCHW1 BCHW2 BCHW3 BCHW4;
  CATEGORICAL = SA;
  CLASSES = c(4);
  TRAINING = BCHW1 BCHW2 BCHW3 BCHW4 (BCH);

ANALYSIS:
  TYPE = MIXTURE;
  ESTIMATOR = MLR;
  STARTS = 0;

MODEL:
%overall%
  [SA$1];

%C#1%
  [SA$1];

%C#2%
  [SA$1];

%C#3%
  [SA$1];

%C#4%
  [SA$1];

OUTPUT:
  TECH1 TECH8;
  CINTERVAL;
  SVALUES;
